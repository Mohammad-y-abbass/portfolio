{
  "websites": [
    {
      "name": "hirelebanese",
      "baseUrl": "https://hirelebanese.com",
      "type": "static",
      "listings": {
        "url": "https://hirelebanese.com/searchresults.aspx?order=date&keywords=&category=10&type=&duration=&country=117,241,258,259,260&state=&city=&emp=&pg=1&s=-1&top=0",
        "pagination": {
          "enabled": true,
          "param": "pg",
          "maxPages": 10,
          "startPage": 1
        },
        "jobCardSelector": "div.panel.panel-default.jobs-margin",
        "fields": {
          "title": { "selector": "div.panel-title h4 a", "type": "text" },
          "url": { "selector": "div.panel-title h4 a", "type": "href" },
          "companyLocation": { "selector": "div.row div.col-xs-9", "type": "text", "index": 0 },
          "datePostedRaw": { "selector": "div.row div.col-xs-12[style*='color: gray']", "type": "text" },
          "summary": { "selector": "div.row div.col-xs-12:not([style])", "type": "text" }
        }
      },
      "details": {
        "urlTemplate": "https://hirelebanese.com/jobdetails.aspx?id={id}",
        "fields": {
          "title": { "selector": "#title", "type": "text" },
          "company": { "selector": "#company", "type": "text" },
          "category": { "selector": "#category", "type": "text" },
          "location": { "selector": "#location", "type": "text" },
          "datePostedRaw": { "selector": "#date", "type": "text" },
          "salary": { "selector": "#salary", "type": "text" },
          "employeeType": { "selector": "#employee_type", "type": "text" },
          "description": { "selector": "#description", "type": "html" }
        }
      },
      "dateParse": { "format": "Posted at MMM DD, YYYY", "timezone": "UTC" }
    },
    {
      "name": "weworkremotely",
      "baseUrl": "https://weworkremotely.com",
      "type": "static",
      "listings": {
        "url": "https://weworkremotely.com/",
        "jobCardSelector": "section.jobs li.new-listing-container",
        "fields": {
          "title": { "selector": "h3.new-listing__header__title span.new-listing__header__title__text", "type": "text" },
          "url": { "selector": "a.listing-link--unlocked", "type": "href" },
          "company": { "selector": "p.new-listing__company-name", "type": "text" },
          "location": { "selector": "p.new-listing__company-headquarters", "type": "text" },
          "datePostedRaw": { "selector": "p.new-listing__header__icons__date", "type": "text" },
          "categories": { "selector": "div.new-listing__categories", "type": "text" }
        }
      },
      "dateParse": { "format": "relative", "timezone": "UTC", "relative": true },
      "details": {
        "urlTemplate": "{url}",
        "fields": {
          "title": { "selector": "h1.lis-container__header__hero__company-info__title", "type": "text" },
          "company": { "selector": "div.lis-container__job__sidebar__companyDetails__info__title", "type": "text" },
          "location": { "selector": "li.lis-container__job__sidebar__job-about__list__item:contains(\"Region\") a", "type": "text" },
          "jobType": { "selector": "li.lis-container__job__sidebar__job-about__list__item:contains(\"Job type\") a", "type": "text" },
          "category": { "selector": "li.lis-container__job__sidebar__job-about__list__item:contains(\"Category\") a", "type": "text" },
          "skills": { "selector": "li.lis-container__job__sidebar__job-about__list__item:contains(\"Skills\") a", "type": "text" },
          "salary": { "selector": "li.lis-container__job__sidebar__job-about__list__item:contains(\"Salary\") a", "type": "text" },
          "description": { "selector": "div.lis-container__job__content__description", "type": "html" }
        }
      }
    },
    {
